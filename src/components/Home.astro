---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ui, INSTAGRAM_URL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// src/assets/gallery/ に置いた画像を、ファイル名順に自動で並べる。
const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', {
    eager: true,
  }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<Base lang={lang}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.heading}</h1>
      <p class="lead">{t.hero.lead}</p>
      <a class="btn" href="#join">{t.hero.cta}</a>
    </div>
  </section>

  <section class="block" id="about">
    <div class="wrap">
      <h2>{t.about.heading}</h2>
      {t.about.body.map((p) => <p>{p}</p>)}
      <ul class="facts">
        {
          t.about.facts.map((f) => (
            <li>
              <span class="k">{f.label}</span>
              <span class="v">{f.value}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block" id="join">
    <div class="wrap">
      <h2>{t.join.heading}</h2>
      <p>{t.join.lead}</p>
      <dl class="rows">
        {
          t.join.rows.map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="note">{t.join.note}</p>
    </div>
  </section>

  <section class="block" id="gallery">
    <div class="wrap">
      <h2>{t.gallery.heading}</h2>
      <p>{t.gallery.lead}</p>
      {
        photos.length > 0 ? (
          <div class="gallery-grid">
            {photos.map((src) => (
              <Image src={src} alt={t.gallery.alt} width={480} height={480} loading="lazy" />
            ))}
          </div>
        ) : (
          <div class="gallery-grid" aria-hidden="true">
            {Array.from({ length: 6 }).map(() => (
              <div class="ph">{t.gallery.placeholder}</div>
            ))}
          </div>
        )
      }
      <a class="btn" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">{t.gallery.cta}</a>
    </div>
  </section>

  <section class="block" id="contact">
    <div class="wrap">
      <h2>{t.contact.heading}</h2>
      <p>{t.contact.lead}</p>
      <a class="btn" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">{t.contact.cta}</a>
    </div>
  </section>
</Base>
