---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mascots from './Mascots.astro';
import CourtLines from './CourtLines.astro';
import { ui, INSTAGRAM_URL, FORM_URL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = new URL(`${base}/`, Astro.site).href;
const other: Lang = lang === 'ja' ? 'en' : 'ja';
const otherHref = other === 'ja' ? `${base}/` : `${base}/en/`;

// src/assets/gallery/ に置いた画像を、ファイル名順に自動で並べる。
const photos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', {
    eager: true,
  }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);
---

<Base lang={lang}>
  <section class="hero">
    <CourtLines />
    <div class:list={['wrap', 'hero-inner', { 'has-photo': photos.length > 0 }]}>
      <div class="hero-text">
        <p class="badge">{t.hero.badge}</p>
        <p class="wordmark" aria-hidden="true">SURABAYA<br />JAPANESE<br /><em>BASKET</em></p>
        <h1>{t.hero.heading}</h1>
        <p class="lead">{t.hero.lead}</p>
        <div class="cta-row">
          <a class="btn" href={FORM_URL} target="_blank" rel="noopener noreferrer">{t.hero.cta}</a>
          <a class="btn ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">{t.hero.ctaDm}</a>
        </div>
        <p class="form-note">{t.hero.formNote}</p>
        <p class="link-row">
          <a class="lang-link" href="#join">{t.hero.ctaSub} ↓</a>
          <a class="lang-link" href={otherHref} hreflang={other} lang={other}>{t.hero.langLink} →</a>
        </p>
      </div>
      {
        photos[0] && (
          <figure class="hero-photo">
            <Image
              src={photos[0]}
              alt={t.hero.photoAlt}
              widths={[640, 960, 1280]}
              sizes="(min-width: 900px) 520px, calc(100vw - 48px)"
              loading="eager"
            />
          </figure>
        )
      }
    </div>
    <Mascots bold />
  </section>

  <section class="block" id="about">
    <div class="wrap">
      <p class="kicker">ABOUT</p>
      <h2>{t.about.heading}</h2>
      {t.about.body.map((p) => <p>{p}</p>)}
      <ul class="facts">
        {
          t.about.facts.map((f) => (
            <li>
              <span class="k">{f.label}</span>
              <span class="v">{f.value}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="block tint" id="join">
    <div class="wrap">
      <p class="kicker">JOIN US</p>
      <h2>{t.join.heading}</h2>
      <p>{t.join.lead}</p>
      <dl class="info-grid">
        {
          t.join.rows.map((r, i) => (
            <div class:list={['info', { big: i === 1, wide: i === 2 }]}>
              <dt>{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="note">{t.join.note}</p>
      <div class="cta-row join-cta">
        <a class="btn" href={FORM_URL} target="_blank" rel="noopener noreferrer">{t.hero.cta}</a>
        <a class="btn ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">{t.hero.ctaDm}</a>
      </div>
    </div>
  </section>

  <section class="block" id="faq">
    <div class="wrap">
      <p class="kicker">FAQ</p>
      <h2>{t.faq.heading}</h2>
      <p>{t.faq.lead}</p>
      <div class="faq-list">
        {
          t.faq.items.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block tint" id="gallery">
    <div class="wrap">
      <p class="kicker">GALLERY</p>
      <h2>{t.gallery.heading}</h2>
      <p>{t.gallery.lead}</p>
      {
        photos.length > 0 ? (
          <div class:list={['gallery-grid', { many: photos.length > 4 }]}>
            {photos.map((src) => (
              <Image src={src} alt={t.gallery.alt} width={720} height={480} loading="lazy" />
            ))}
          </div>
        ) : (
          <div class="gallery-grid" aria-hidden="true">
            {Array.from({ length: 6 }).map(() => (
              <div class="ph">{t.gallery.placeholder}</div>
            ))}
          </div>
        )
      }
      <a class="btn ghost" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">{t.gallery.cta}</a>
    </div>
  </section>

  <section class="block" id="share">
    <div class="wrap">
      <p class="kicker">SHARE</p>
      <h2>{t.share.heading}</h2>
      <p>{t.share.lead}</p>
      <div class="share-grid">
        <figure class="share-card">
          <a href={`${base}/banners/banner-square.png`} target="_blank" rel="noopener">
            <img src={`${base}/banners/banner-square.png`} alt={t.share.squareAlt} width="1080" height="1080" loading="lazy" />
          </a>
          <figcaption>
            <span class="share-name">{t.share.squareLabel}</span>
            <a class="btn small" href={`${base}/banners/banner-square.png`} download="surabaya-japanese-basket-square.png">{t.share.download}</a>
          </figcaption>
        </figure>
        <figure class="share-card story">
          <a href={`${base}/banners/banner-story.png`} target="_blank" rel="noopener">
            <img src={`${base}/banners/banner-story.png`} alt={t.share.storyAlt} width="1080" height="1920" loading="lazy" />
          </a>
          <figcaption>
            <span class="share-name">{t.share.storyLabel}</span>
            <a class="btn small" href={`${base}/banners/banner-story.png`} download="surabaya-japanese-basket-story.png">{t.share.download}</a>
          </figcaption>
        </figure>
      </div>
      <button type="button" class="btn ghost copy-btn" data-copy={siteUrl} data-done={t.share.copied}>{t.share.copyUrl}</button>
    </div>
  </section>

  <section class="closing" id="contact">
    <div class="wrap">
      <p class="kicker light">CONTACT</p>
      <h2>{t.contact.title}</h2>
      <p>{t.contact.lead}</p>
      <div class="cta-row">
        <a class="btn invert" href={FORM_URL} target="_blank" rel="noopener noreferrer">{t.contact.cta}</a>
        <a class="btn outline-light" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">{t.contact.ctaDm}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // 「URLをコピー」ボタン。クリップボードが使えない環境では選択用に URL を表示する。
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const original = btn.textContent;
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = btn.dataset.done ?? 'OK';
        setTimeout(() => (btn.textContent = original), 2000);
      } catch {
        window.prompt('URL', url);
      }
    });
  });
</script>
