---
import '../styles/global.css';
import Mascots from '../components/Mascots.astro';
import { ui, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'ja' ? 'en' : 'ja';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (l: Lang) => (l === 'ja' ? `${base}/` : `${base}/en/`);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang="ja" href={href('ja')} />
    <link rel="alternate" hreflang="en" href={href('en')} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="header">
      <div class="wrap">
        <a class="brand" href={href(lang)}>🏀 {t.siteName}</a>
        <nav class="nav" aria-label="Main">
          <a href="#about">{t.nav.about}</a>
          <a href="#join">{t.nav.join}</a>
          <a href="#gallery">{t.nav.gallery}</a>
          <a href="#contact">{t.nav.contact}</a>
          <a class="lang" href={href(other)} hreflang={other} lang={other}>{languages[other]}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <Mascots compact />
        <p class="tagline">{t.tagline}</p>
        <p>{t.footer}</p>
      </div>
    </footer>
  </body>
</html>
