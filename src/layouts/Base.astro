---
import '../styles/global.css';
import Mascots from '../components/Mascots.astro';
import { ui, languages, INSTAGRAM_URL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'ja' ? 'en' : 'ja';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (l: Lang) => (l === 'ja' ? `${base}/` : `${base}/en/`);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" hreflang="ja" href={href('ja')} />
    <link rel="alternate" hreflang="en" href={href('en')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;1,800&family=Noto+Sans+JP:wght@400;700;900&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="header">
      <div class="wrap">
        <a class="brand" href={href(lang)}>
          <svg class="ball" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="10.5"></circle>
            <path d="M12 1.5v21M1.5 12h21M4.6 4.6c3.6 3.6 3.6 11.2 0 14.8M19.4 4.6c-3.6 3.6-3.6 11.2 0 14.8"></path>
          </svg>
          <span>{t.siteName}</span>
        </a>
        <nav class="nav" aria-label="Main">
          <div class="nav-links">
            <a href="#about">{t.nav.about}</a>
            <a href="#join">{t.nav.join}</a>
            <a href="#gallery">{t.nav.gallery}</a>
          </div>
          <a class="lang" href={href(other)} hreflang={other} lang={other}>{languages[other]}</a>
          <a class="nav-cta" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">{t.nav.cta}</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <Mascots compact />
        <p class="tagline">{t.tagline}</p>
        <p>{t.footer}</p>
      </div>
    </footer>
  </body>
</html>
